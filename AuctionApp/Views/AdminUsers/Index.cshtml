@model List<AuctionApp.Models.Admin.AdminUserVm>
@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<table class="table">
    <thead>
    <tr>
        <th>User name</th>
        <th>Email</th>
        <th>Role</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.UserName</td>
            <td>@user.Email</td>
            <td>@(user.IsAdmin ? "Admin" : "User")</td>
            <td>
                <a asp-controller="AdminAuctions" asp-action="ByUser" asp-route-userName="@user.UserName"
                   class="btn btn-sm btn-outline-primary">Auctions</a>
                @if (!user.IsAdmin)
                {
                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete @user.UserName?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
@model AuctionApp.Models.Auctions.EditAuctionVm

@{
    ViewData["Title"] = "Edit description";
}

<div class="page-header">
    <div>
        <h1>Edit description</h1>
        <p class="lead-in">@Model.Name. Only the description can be changed once an auction is live.</p>
    </div>
</div>

<div class="panel form-narrow">
    <form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="panel-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Name" />
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="6"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save description</button>
            <a class="btn btn-outline-secondary" asp-controller="Auctions" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </form>
</div>

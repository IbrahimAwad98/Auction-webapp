@model AuctionApp.Models.Auctions.CreateAuctionVm

@{
    ViewData["Title"] = "Create auction";
}

<div class="page-header">
    <div>
        <h1>Create auction</h1>
        <p class="lead-in">The name, starting price and end time cannot be changed after the auction is created.</p>
    </div>
</div>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger form-narrow" role="alert">@ViewData["Error"]</div>
}

<div class="panel form-narrow">
    <form method="post" asp-action="Create" class="panel-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="off" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
            <p class="form-hint">Condition, age, pickup details. You can edit this later.</p>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="StartingPrice" class="form-label"></label>
            <div class="input-group">
                <input asp-for="StartingPrice" class="form-control" min="0" step="1" />
                <span class="input-group-text">kr</span>
            </div>
            <span asp-validation-for="StartingPrice" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="EndTime" class="form-label"></label>
            <input asp-for="EndTime" type="datetime-local" class="form-control" />
            <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create auction</button>
            <a class="btn btn-outline-secondary" asp-controller="Auctions" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

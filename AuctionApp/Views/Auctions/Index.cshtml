@model List<AuctionApp.Models.Auctions.AuctionVm>

@{
    ViewData["Title"] = "Active auctions";
    ViewData["EmptyText"] = "There are no active auctions right now.";
}

<div class="page-header">
    <div>
        <h1>Active auctions</h1>
        <p class="lead-in">Sorted by end time, closing soonest first.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Auctions" asp-action="Create">Create auction</a>
</div>

<partial name="_AuctionTable" model="Model" />

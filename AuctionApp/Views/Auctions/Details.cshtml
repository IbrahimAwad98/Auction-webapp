@model AuctionApp.Models.Auctions.AuctionDetailsVm

@{
    ViewData["Title"] = Model.Name;
    bool ended = Model.EndTime <= DateTime.Now;
}

<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p class="lead-in">Sold by @Model.OwnerUserName</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Auctions" asp-action="Index">All auctions</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="details">
    <div>
        <div class="panel">
            <div class="panel-body">
                <h2>Description</h2>
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="muted">The seller has not written a description.</p>
                }
                else
                {
                    <p class="description">@Model.Description</p>
                }
                @if (Model.IsOwner)
                {
                    <p class="mt-3 mb-0"><a asp-controller="Auctions" asp-action="Edit" asp-route-id="@Model.Id">Edit description</a></p>
                }
            </div>
        </div>

        <div class="panel">
            <div class="panel-body pb-0">
                <h2>Bids</h2>
            </div>
            @if (Model.Bids.Count == 0)
            {
                <div class="empty"><p>No bids yet. The first bid must be higher than the starting price.</p></div>
            }
            else
            {
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">Bidder</th>
                        <th scope="col" class="num">Amount</th>
                        <th scope="col" class="num">Placed</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var bid in Model.Bids)
                    {
                        <tr>
                            <td>@bid.UserName</td>
                            <td class="num">@bid.Amount.ToString("N0") kr</td>
                            <td class="num muted">@bid.PlacedAt.ToString("d MMM yyyy, HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <aside class="panel details-side">
        <div class="panel-body">
            <p class="price-label">@(Model.Bids.Count == 0 ? "Starting price" : (ended ? "Final price" : "Current price"))</p>
            <p class="price num">@Model.CurrentPrice.ToString("N0") kr</p>
            <p class="price-meta num">
                @if (ended)
                {
                    <span class="status ended">Ended</span>
                }
                else
                {
                    <span class="status">Active</span>
                }
                @Model.EndTime.ToString("d MMM yyyy, HH:mm")
            </p>

            <dl class="facts mb-3">
                <dt>Starting price</dt>
                <dd class="num">@Model.StartingPrice.ToString("N0") kr</dd>
                <dt>Bids</dt>
                <dd class="num">@Model.Bids.Count</dd>
            </dl>

            @if (ended)
            {
                <p class="muted mb-0">This auction has ended and no longer accepts bids.</p>
            }
            else if (Model.IsOwner)
            {
                <p class="muted mb-0">This is your auction. You cannot bid on your own item.</p>
            }
            else
            {
                <form method="post" asp-action="PlaceBid">
                    <input type="hidden" name="AuctionId" value="@Model.Id" />
                    <label for="Amount" class="form-label">Your bid</label>
                    <div class="input-group">
                        <input type="number" id="Amount" name="Amount" class="form-control" min="@(Model.CurrentPrice + 1)" step="1" required autocomplete="off" />
                        <span class="input-group-text">kr</span>
                    </div>
                    <p class="form-hint">Must be higher than @Model.CurrentPrice.ToString("N0") kr.</p>
                    <button type="submit" class="btn btn-primary w-100">Place bid</button>
                </form>
            }
        </div>
    </aside>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - AuctionApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
@{
    string Active(string controller, string action) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller) &&
        string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), action) ? "active" : "";
}
<header class="topbar">
    <div class="page inner">
        <a class="brand" asp-controller="Home" asp-action="Index">AuctionApp</a>
        <nav aria-label="Main">
            <ul class="topnav">
                <li><a class="@Active("Auctions", "Index")" asp-controller="Auctions" asp-action="Index">Auctions</a></li>
                <li><a class="@Active("Auctions", "MyBids")" asp-controller="Auctions" asp-action="MyBids">My bids</a></li>
                <li><a class="@Active("Auctions", "Won")" asp-controller="Auctions" asp-action="Won">Won</a></li>
                <li><a class="@Active("Home", "About")" asp-controller="Home" asp-action="About">About</a></li>
            </ul>
        </nav>
        <partial name="_LoginPartial" />
    </div>
</header>

<main class="page">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="page">
        AuctionApp, HI1031 Distributed Information Systems, KTH 2026
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

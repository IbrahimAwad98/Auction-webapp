@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page-header">
    <h1>Something went wrong</h1>
</div>

<div class="prose">
    <p>The request could not be completed. Go back and try again, or start from the auction list.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Request ID <code>@Model.RequestId</code></p>
    }
    <div class="form-actions">
        <a class="btn btn-primary" asp-controller="Auctions" asp-action="Index">All auctions</a>
    </div>
</div>

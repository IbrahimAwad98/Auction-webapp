@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    string ActivePage(string page) =>
        string.Equals(ViewContext.RouteData.Values["page"]?.ToString(), page) ? "active" : "";
}
<ul class="topnav">
@if (SignInManager.IsSignedIn(User))
{
    <li><a class="@ActivePage("/Account/Manage/Index")" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage account">@User.Identity?.Name</a></li>
    <li>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
            <button type="submit">Log out</button>
        </form>
    </li>
}
else
{
    <li><a class="@ActivePage("/Account/Register")" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
    <li><a class="@ActivePage("/Account/Login")" asp-area="Identity" asp-page="/Account/Login">Log in</a></li>
}
</ul>
